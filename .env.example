# 艾搭 LLM 配置（可选）：任何 OpenAI 兼容接口均可
# 不配置时，艾搭使用内置模板人格（demo 必能跑）
# AIDA_LLM_BASE_URL=https://api.deepseek.com/v1
# AIDA_LLM_API_KEY=sk-xxx
# AIDA_LLM_MODEL=deepseek-chat
